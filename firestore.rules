rules_version = '2';

// Paste this into: Firebase console > Firestore Database > Rules > Publish
// ⚠️ Replace "admin@bioseed.ma" below with your real admin email(s) —
//    it must match the ADMIN_EMAILS list in firebase-init.js exactly.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in ["lahmar.mohamed.302@gmail.com"];
    }

    // users/{uid} — each customer's own profile (name, phone, city)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // orders/{orderId}
    match /orders/{orderId} {
      // anyone can place an order (guest checkout allowed)
      allow create: if true;
      // a customer can read only their own orders; the admin can read all
      allow read: if isAdmin() ||
                     (request.auth != null && resource.data.uid == request.auth.uid);
      // only the admin can change an order (e.g. update status)
      allow update, delete: if isAdmin();
    }
  }
}
